# ============================================================
# Add your OpenAI API key below to unlock:
#   - OpenAI text-embedding-3-small for higher-quality semantic matching
#   - GPT-powered resume improvement suggestions
# Leave it blank and the app automatically falls back to a free,
# 100% local embedding model (sentence-transformers) + rule-based
# suggestions - no key required, works out of the box either way.
# ============================================================
OPENAI_API_KEY=

# Optional: override default OpenAI models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Local fallback embedding model (used only when OPENAI_API_KEY is blank)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL connection string.
# Leave blank to automatically use a local SQLite file instead (no setup needed).
# Example: postgresql://username:password@localhost:5432/resume_analyzer
DATABASE_URL=

# Flask
FLASK_SECRET_KEY=change-this-secret-key
FLASK_DEBUG=True
PORT=5000

# Free, no-key-required job board API
JOB_API_URL=https://www.arbeitnow.com/api/job-board-api

# Max resume upload size in MB
MAX_UPLOAD_MB=5

# Allow the React dev server to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
