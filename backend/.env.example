# Docker Compose supplies DATABASE_URL. For a hosted database, use a full PostgreSQL URL.
# Hosted alternative: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Required for AI operations; enter your key only in backend/.env.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embeddings use 1536 dimensions. Changing model requires re-embedding records.

FLASK_SECRET_KEY=change-this-secret-key
FLASK_DEBUG=False
PORT=5000
JOB_API_URL=https://www.arbeitnow.com/api/job-board-api
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
